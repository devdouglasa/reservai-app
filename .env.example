# Optional override; leave commented to use automatic development configuration.
# EXPO_PUBLIC_API_URL=https://your-api.example.com/api/v1
# Android emulator: http://10.0.2.2:3000/api/v1
# Physical device: http://YOUR_COMPUTER_LAN_IP:3000/api/v1
# Without this variable, native development uses the Expo LAN host on port 3000.
# Android falls back to 10.0.2.2 when no LAN host is available; web uses localhost.
